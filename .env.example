# NeonDB Serverless PostgreSQL Connection String
# Example: postgresql://username:password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://neondb_owner:your_password@ep-silver-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Cloudinary Credentials for Jewelry Product Photos
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Public App Base URL (Used for generating QR verification URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
